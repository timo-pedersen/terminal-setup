AllowSetSelection=yes
CopyOnSelect=yes
RightClickAction=paste
ClicksTargetApp=no
TabBar=1
SessionGeomSync=2
ZoomMouse=yes

CtrlShiftShortcuts=yes
KeyFunctions=d:`echo -n `date``;t:new-tab-cwd;n:new-window;

Background=C:\msys64\home\terminal_texture2.jpg
ThemeDark=xterm
Transparency=low
OpaqueWhenFocused=yes
CursorType=line
FontHeight=10
Font=0xProto Nerd Font Mono
FontSmoothing=full
Locale=en_US
Language=en_US
Charset=UTF-8
Columns=166
Rows=33
PgUpDnScroll=no
BellType=0
StatusLine=no

TabFont=0xProto Nerd Font Mono
